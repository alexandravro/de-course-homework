# КРОК 3 — ENTRYPOINT замість CMD + .dockerignore (файл поряд).
# ENTRYPOINT фіксує програму (python main.py); якби додали CMD — це були б аргументи
# за замовчуванням. .dockerignore відсікає з build context зайве (Dockerfile-и, .env,
# README, __pycache__) — образ чистіший, build швидший.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENTRYPOINT ["python", "main.py"]
